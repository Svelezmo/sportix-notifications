# =====================================================================
#  sportix-notifications - variables de entorno (PLANTILLA)
#  Copie este archivo como .env (junto al pom.xml) y llene los valores.
#  El .env NUNCA se sube a Git.
# =====================================================================

# Puerto del microservicio (Sportixcore lo busca en http://localhost:5000)
PORT=5000

# Clave compartida con Sportixcore (NOTIFICATION_API_KEY en su .env).
# Debe ser la MISMA en los dos. Vacía = no se exige (solo para pruebas locales).
NOTIFICATION_API_KEY=

# smtp    -> envía de verdad por Gmail
# console -> no envía: imprime el correo y el código en la consola (desarrollo)
MAIL_MODE=console

# ---------- Gmail (solo con MAIL_MODE=smtp) ----------
# Cuenta de Gmail con verificación en dos pasos activa
GMAIL_USERNAME=
# Contraseña de aplicación de 16 letras (NO la contraseña normal de Gmail)
GMAIL_APP_PASSWORD=
# Nombre que verá el destinatario como remitente
MAIL_FROM_NAME=Sportix

# true = responde a Sportixcore sin esperar a Gmail (el correo sale en segundo plano)
MAIL_ASYNC=false
